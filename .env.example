# ===== Telegram =====
TELEGRAM_BOT_TOKEN=你的_BotFather_Token

# ===== Cloudflare Workers AI（生成层）=====
CF_ACCOUNT_ID=你的_cloudflare_account_id
CF_API_TOKEN=你的_cloudflare_api_token（需 Workers AI 权限）
CF_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# ===== RAG / 路径（一般无需改）=====
DATA_DIR=./data
CHROMA_DIR=./chroma
EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CHUNK_CHARS=600
CHUNK_OVERLAP=100
TOP_K=5

# ===== 爬虫（可选）=====
SCRAPE_MAX_PAGES=200
SCRAPE_DELAY=0.5
